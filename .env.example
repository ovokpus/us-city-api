# Copy to .env (gitignored). Local-only Postgres credentials for the compose database.
POSTGRES_USER=cities
POSTGRES_PASSWORD=cities
POSTGRES_DB=cities
# Used by `npm run dev` outside Docker (compose builds its own URL for the api container)
DATABASE_URL=postgres://cities:cities@localhost:5432/cities
PORT=3000

DB_PORT=5432
API_PORT=3000
FRONTEND_PORT=8080
